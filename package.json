{
  "name": "la-cd4-website",
  "version": "0.1.0",
  "private": true,
  "description": "Council District 4 (City of Los Angeles) neutral service-portal redesign — staging build",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
