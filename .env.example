# Deployment environment. Anything other than "production" keeps the site noindex
# and shows the staging banner. Do NOT set to production without City authorization.
NEXT_PUBLIC_SITE_ENV=staging
# Canonical origin used for metadata/sitemap once a production domain is approved.
NEXT_PUBLIC_SITE_URL=
# City global bar: "official" (default) loads https://navbar.lacity.org/global_nav.js; "static" shows only the built-in copy.
NEXT_PUBLIC_CITY_NAVBAR=official
# Optional. Weather conditions come from AccuWeather (and are credited "Powered by AccuWeather") when this is set.
# Server-side only; never commit a real key. Without it the readout uses Open-Meteo and is credited to Open-Meteo.
ACCUWEATHER_API_KEY=
# Optional. Enables Google Places address suggestions in the District Checker field.
# Restrict the key to this site's domains and to the Places API in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
